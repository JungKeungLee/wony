# Supabase 프로젝트 설정 (Project Settings > API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 사이트 모드: "contribute"(참여용 사전 공개, 기본값) | "public"(정식 공개).
# 값을 비워두거나 "public"이 아닌 값을 넣으면 항상 contribute로 취급한다.
NEXT_PUBLIC_SITE_MODE=contribute

# contribute 모드에서도 개발자가 전체 사이트를 미리 볼 수 있게 하는 비밀 키.
# ?previewFull=이_값 으로 접속하면 이후 이 브라우저는 30일간 public 모드처럼 동작한다.
# 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다 - 클라이언트 번들에 노출되면 안 된다.
FULL_PREVIEW_KEY=

# VIDEO 페이지의 "이 영상에 한 표" 버튼 노출 여부. "false"로 두면 버튼만 숨겨지고
# 기존 영상/투표 데이터는 그대로 유지된다. 비워두면 기본값(켜짐)으로 동작한다.
NEXT_PUBLIC_VIDEO_VOTING_ENABLED=true
