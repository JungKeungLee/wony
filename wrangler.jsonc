// Cloudflare(cloudflare 브랜치) 전용 - Vercel(main)에서는 사용하지 않는다.
// 운영 도메인은 연결하지 않는다(routes 없음) - workers.dev 테스트 주소로만 검증한다.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "woni-fansite",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
		// 정적 생성된 페이지 캐시(open-next.config.ts의 staticAssetsIncrementalCache)는
		// assets/cdn-cgi/_next_cache/에 들어간다. 비공개 페이지 HTML도 포함되므로, 이 경로로
		// 들어온 외부 요청은 정적 파일로 바로 내보내지 않고 Worker가 먼저 받게 한다
		// (Worker 내부의 env.ASSETS.fetch는 이 규칙과 무관하게 계속 읽을 수 있다).
		"run_worker_first": ["/cdn-cgi/*"]
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "woni-fansite"
		}
	],
	"observability": {
		"enabled": true
	}
	// 이미지 최적화(IMAGES 바인딩)는 사용하지 않는다 - next.config.ts의 images.unoptimized 참고.
	// FULL_PREVIEW_KEY는 여기에 적지 않는다 - `wrangler secret put` 또는 대시보드 Secret으로만 넣는다.
}
